# Copy to .env.local for local development; set the same names in Vercel (Production and Preview).
# From the Supabase project (Sydney): Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: never prefix with NEXT_PUBLIC_, never commit. Used by approvals after the engine re-run.
SUPABASE_SERVICE_ROLE_KEY=

# Show "Sign in with Microsoft 365" once the Azure provider is set up in Supabase (docs/launch.md).
NEXT_PUBLIC_MICROSOFT_SIGN_IN=0
